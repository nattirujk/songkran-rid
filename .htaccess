# Block direct web access to this directory and any database files.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
	Order Deny,Allow
	Deny from all
</IfModule>

<FilesMatch "\.(db|sqlite|sqlite3)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>

	<IfModule !mod_authz_core.c>
		Order Deny,Allow
		Deny from all
	</IfModule>
</FilesMatch>
